{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PublicarImagenesStaging",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": [
        "arn:aws:ecr:us-east-1:<AWS_ACCOUNT_ID>:repository/sagrilaft-staging-backend",
        "arn:aws:ecr:us-east-1:<AWS_ACCOUNT_ID>:repository/sagrilaft-staging-formulario-publico",
        "arn:aws:ecr:us-east-1:<AWS_ACCOUNT_ID>:repository/sagrilaft-staging-portal-interno",
        "arn:aws:ecr:us-east-1:<AWS_ACCOUNT_ID>:repository/sagrilaft-staging-keycloak"
      ]
    },
    {
      "Sid": "LeerConfiguracionDeBuildStaging",
      "Effect": "Allow",
      "Action": "ssm:GetParameters",
      "Resource": [
        "arn:aws:ssm:us-east-1:<AWS_ACCOUNT_ID>:parameter/sagrilaft/staging/config/APP_ENV",
        "arn:aws:ssm:us-east-1:<AWS_ACCOUNT_ID>:parameter/sagrilaft/staging/config/FRONTEND_URL",
        "arn:aws:ssm:us-east-1:<AWS_ACCOUNT_ID>:parameter/sagrilaft/staging/config/PORTAL_INTERNO_URL",
        "arn:aws:ssm:us-east-1:<AWS_ACCOUNT_ID>:parameter/sagrilaft/staging/config/KEYCLOAK_ISSUER_URL",
        "arn:aws:ssm:us-east-1:<AWS_ACCOUNT_ID>:parameter/sagrilaft/staging/config/KEYCLOAK_REALM",
        "arn:aws:ssm:us-east-1:<AWS_ACCOUNT_ID>:parameter/sagrilaft/staging/config/KEYCLOAK_CLIENT_ID"
      ]
    }
  ]
}
