{
  "app": "npx ts-node --prefer-ts-exts bin/app.ts",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "**/__pycache__", "**/*.pyc"]
  },
  "context": {
    "environment": "prod",
    "region": "us-east-1",
    "hostedZoneName": "ia.blend360.com",
    "domainName": "forms-sagrilaft.ia.blend360.com",
    "portalDomainName": "sagrilaft.ia.blend360.com",
    "keycloakDomainName": "login-sagrilaft.ia.blend360.com",
    "@aws-cdk/aws-apigateway:usagePlanKeyOrderInsensitiveId": true,
    "@aws-cdk/aws-cloudfront:defaultSecurityPolicyTLSv1.2_2021": true,
    "@aws-cdk/aws-rds:lowercaseDbIdentifier": false
  }
}
