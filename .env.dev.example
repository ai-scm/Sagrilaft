# ── Plantilla de entorno: DESARROLLO LOCAL (docker-compose.dev.yml) ─────────
# Copia este archivo a `.env` y reemplaza los valores marcados como "changeme".
# Validado por `scripts/validate_envs.py` (python3 scripts/validate_envs.py).

# ── Entorno ──────────────────────────────────────────────────────────────────
APP_ENV=development

# ── Base de datos (PostgreSQL local vía docker-compose.dev.yml) ─────────────
POSTGRES_DB=sagrilaft
POSTGRES_USER=sagrilaft
POSTGRES_PASSWORD=changeme-local-only
DATABASE_URL=postgresql+psycopg://sagrilaft:changeme-local-only@localhost:5432/sagrilaft
PORT_PUBLICO=5173
PORT_PORTAL=5174

# ── Frontend / CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
PORTAL_INTERNO_URL=http://localhost:5174

# ── Almacenamiento ───────────────────────────────────────────────────────────
STORAGE_BACKEND=local
# S3_BUCKET no se usa con STORAGE_BACKEND=local; se declara vacío solo para
# que scripts/validate_envs.py no lo marque como faltante.
S3_BUCKET=

# ── AWS / Bedrock (opcional en dev — deja BEDROCK_MODEL_ID vacío para deshabilitar IA) ──
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# ── Zoho Sign (usa ZOHO_SIGN_TESTING=true / sandbox en dev) ─────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_REDIRECT_URI=http://localhost:8000/api/firma/zoho/callback
ZOHO_WEBHOOK_SECRET=
ZOHO_WEBHOOK_SIGNATURE_HEADER=X-ZS-WEBHOOK-SIGNATURE
ZOHO_SIGN_TESTING=true

# ── SMTP / SES (opcional en dev — deja SES_NOTIFICACIONES_ENABLED=false) ────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-responder@localhost
SES_EMAIL_ORIGEN=
SES_NOTIFICACIONES_ENABLED=false
ALERTAS_EMAIL_DESTINATARIO=
SNS_NOTIFICACIONES_ENABLED=false
SNS_TOPIC_ARN=

# ── Keycloak (portal interno) ────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=sagrilaft
KEYCLOAK_CLIENT_ID=sagrilaft-portal
KEYCLOAK_ISSUER_URL=http://localhost:8080
KEYCLOAK_DB_URL=jdbc:postgresql://localhost:5432/sagrilaft
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme-local-only
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_DB_USER=sagrilaft
KEYCLOAK_DB_PASSWORD=changeme-local-only
PORTAL_AUTH_DISABLED=false

# ── Listas de cautela (verificación PLAFT) ──────────────────────────────────
# "dummy" simula resultados — permitido SOLO en development (nunca en staging/prod).
PROVEEDOR_LISTAS_CAUTELA=dummy
SAGRILAFT_API_URL=
SAGRILAFT_API_KEY=

# ── Seguridad / runtime ──────────────────────────────────────────────────────
SECRET_KEY=changeme-genera-una-clave-aleatoria-larga
MAX_UPLOAD_SIZE_MB=15
UVICORN_WORKERS=1
TRUSTED_PROXY_IPS=
JWKS_CACHE_TTL_SECONDS=

# ── Build del frontend (Vite) ────────────────────────────────────────────────
VITE_BACKEND_URL=http://localhost:8000
VITE_PORTAL_INTERNO_URL=http://localhost:5174
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=sagrilaft
VITE_KEYCLOAK_CLIENT_ID=sagrilaft-portal
VITE_RAZON_SOCIAL=HIGH TECH SOFTWARE S.A.S
VITE_CORREO_DATOS=administrativocol@blend360.com
