# =============================================================================
# SAGRILAFT — Variables de entorno
#
# Copia este archivo a .env y completa los valores antes de levantar el stack.
#
#   cp .env.example .env
#
# NUNCA subas .env al repositorio (.gitignore ya lo excluye).
# Las variables marcadas como [REQUERIDA] bloquean el arranque si están vacías.
# Las marcadas [DEV] solo se usan con docker-compose.dev.yml.
# Las marcadas [PROD] solo aplican al stack de producción.
# =============================================================================


# =============================================================================
# BASE DE DATOS
# =============================================================================

# [REQUERIDA] Producción: endpoint de RDS
#   Formato: postgresql+psycopg://usuario:contraseña@host:5432/nombre_bd
#   En dev este valor es sobreescrito automáticamente por docker-compose.dev.yml
DATABASE_URL=postgresql+psycopg://usuario:contraseña@host:5432/sagrilaft

# [DEV] Credenciales del contenedor PostgreSQL local (solo docker-compose.dev.yml)
POSTGRES_DB=sagrilaft
POSTGRES_USER=sagrilaft_user
POSTGRES_PASSWORD=cambia_esta_contraseña_local


# =============================================================================
# APLICACIÓN BACKEND
# =============================================================================

# [REQUERIDA PROD] URL pública del frontend — usada en los CORS y en los correos
#   Ej: https://sagrilaft.tudominio.com
FRONTEND_URL=https://sagrilaft.tudominio.com

# [REQUERIDA] Clave secreta para firmar reportes de auditoría con HMAC-SHA256.
#   Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Número de workers Uvicorn (recomendado: 2 × vCPUs del servidor)
UVICORN_WORKERS=4

# Rango CIDR del proxy de confianza (nginx → backend dentro de la red Docker)
# No cambiar salvo que modifiques la subnet de Docker Compose
TRUSTED_PROXY_IPS=172.0.0.0/8

# Puerto expuesto del frontend en el host (solo relevante si no usas ALB en :80)
PORT_FRONTEND=80


# =============================================================================
# ALMACENAMIENTO DE ARCHIVOS
# =============================================================================

# "local"  → volumen EBS del EC2  (sin dependencias externas, opción por defecto)
# "s3"     → Amazon S3            (recomendado para producción de alta disponibilidad)
STORAGE_BACKEND=local

# [REQUERIDA si STORAGE_BACKEND=s3] Nombre del bucket S3
S3_BUCKET=


# =============================================================================
# AWS — Bedrock IA + S3 + SES
# =============================================================================

AWS_REGION=us-east-1

# Dejar VACÍO en producción EC2 — boto3 usa el IAM Role del EC2 automáticamente.
# Solo rellenar si corres fuera de AWS (dev sin Docker, CI, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# [REQUERIDA] ARN del modelo Bedrock para el análisis IA de documentos.
#   Si se deja vacío el análisis IA queda deshabilitado (warning en arranque).
#   Ej: arn:aws:bedrock:us-east-1:123456789012:inference-profile/us.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_ID=


# =============================================================================
# ZOHO SIGN — Firma electrónica
# =============================================================================

# [REQUERIDAS] Credenciales de la aplicación en Zoho API Console
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Token secreto que Zoho envía en cada webhook — validado con HMAC
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
ZOHO_WEBHOOK_SECRET=

# "true" activa el modo sandbox de Zoho Sign (no envía firmas reales)
# Sobreescrito a "true" automáticamente en docker-compose.dev.yml
ZOHO_SIGN_TESTING=false


# =============================================================================
# SMTP — Correo electrónico (AWS SES recomendado)
# =============================================================================

# Host SMTP de SES (varía por región)
#   Ej: email-smtp.us-east-1.amazonaws.com
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587

# Credenciales SMTP de SES — se generan en IAM → SES SMTP settings
# Son distintas de las credenciales IAM de AWS
SMTP_USER=
SMTP_PASSWORD=

# Dirección remitente verificada en SES
#   Ej: sagrilaft@tudominio.com
SMTP_FROM=sagrilaft@tudominio.com


# =============================================================================
# KEYCLOAK — Autenticación portal interno
# =============================================================================

# ── Servicio Keycloak ─────────────────────────────────────────────────────────

# Usuario administrador de la consola Keycloak
KEYCLOAK_ADMIN=admin

# [REQUERIDA] Contraseña del administrador Keycloak
#   Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
KEYCLOAK_ADMIN_PASSWORD=

# [PROD] Hostname público de Keycloak (sin protocolo)
#   Ej: auth.tudominio.com
#   En dev: dejar vacío — Keycloak escucha en localhost:8080
KEYCLOAK_HOSTNAME=

# [PROD] Base de datos de Keycloak en RDS (puede ser la misma instancia, DB: keycloak)
#   Formato JDBC: jdbc:postgresql://host:5432/keycloak
KEYCLOAK_DB_URL=
KEYCLOAK_DB_USER=
KEYCLOAK_DB_PASSWORD=

# ── Integración backend ───────────────────────────────────────────────────────

# URL interna que el backend usa para obtener las claves JWKS.
#   En Docker: http://keycloak:8080   (nombre del servicio en la red interna)
#   En dev sin Keycloak: dejar vacío (auth deshabilitada via PORTAL_AUTH_DISABLED)
KEYCLOAK_URL=http://keycloak:8080

KEYCLOAK_REALM=sagrilaft
KEYCLOAK_CLIENT_ID=sagrilaft-portal

# URL pública de Keycloak — usada para verificar el claim "iss" del JWT.
#   Debe coincidir con la URL con la que el browser llega a Keycloak.
#   En prod con ALB: https://auth.tudominio.com
#   En dev local:    http://localhost:8080
#   Si está vacío, se usa KEYCLOAK_URL
KEYCLOAK_ISSUER_URL=https://auth.tudominio.com

# ── Integración frontend (Vite build-time) ────────────────────────────────────
# Estas variables se inyectan en el bundle de React durante el build.
# Si VITE_KEYCLOAK_URL está vacío, el login Keycloak queda desactivado en el frontend.

VITE_KEYCLOAK_URL=https://auth.tudominio.com
VITE_KEYCLOAK_REALM=sagrilaft
VITE_KEYCLOAK_CLIENT_ID=sagrilaft-portal


# =============================================================================
# SOLO DESARROLLO — NO USAR EN PRODUCCIÓN
# =============================================================================

# Deshabilita la validación JWT del portal interno.
# El backend devuelve un usuario ficticio "dev@localhost" con todos los roles.
# NUNCA establecer en "true" en un entorno accesible desde internet.
# docker-compose.dev.yml ya lo fuerza a "true" — no hace falta aquí en dev.
# PORTAL_AUTH_DISABLED=true
