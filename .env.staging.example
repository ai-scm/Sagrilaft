# ── Plantilla de entorno: STAGING ───────────────────────────────────────────
# Usada por scripts/build_and_push_ecr_images.py (--env-file, VITE_* + AWS_REGION)
# y scripts/sync_aws_runtime_assets.py (--env-file, sincroniza Secrets Manager/SSM).
# Copia a `.env.staging`, reemplaza cada "REPLACE_STAGING_*" con el valor real
# y NUNCA commitees ese archivo (ya está en .gitignore).
# Validado por `scripts/validate_envs.py`.

# ── Entorno ──────────────────────────────────────────────────────────────────
APP_ENV=staging

# ── Frontend / CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=https://forms-staging-sagrilaft.ia.blend360.com
PORTAL_INTERNO_URL=https://staging-sagrilaft.ia.blend360.com

# ── Almacenamiento ───────────────────────────────────────────────────────────
STORAGE_BACKEND=s3
S3_BUCKET=REPLACE_STAGING_S3_BUCKET

# ── AWS / Bedrock ────────────────────────────────────────────────────────────
# No incluyas AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY aquí: en ECS se usa el
# Task Role (IAM), nunca credenciales estáticas (scripts/validate_envs.py lo
# marca como PROHIBIDO en staging/prod).
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=REPLACE_STAGING_BEDROCK_MODEL_ID

# ── Zoho Sign (sandbox en staging) ──────────────────────────────────────────
ZOHO_CLIENT_ID=REPLACE_STAGING_ZOHO_CLIENT_ID
ZOHO_CLIENT_SECRET=REPLACE_STAGING_ZOHO_CLIENT_SECRET
ZOHO_REFRESH_TOKEN=REPLACE_STAGING_ZOHO_REFRESH_TOKEN
ZOHO_REDIRECT_URI=https://staging-sagrilaft.ia.blend360.com/oauth/zoho/callback
ZOHO_WEBHOOK_SECRET=REPLACE_STAGING_ZOHO_WEBHOOK_SECRET
ZOHO_WEBHOOK_SIGNATURE_HEADER=X-ZS-WEBHOOK-SIGNATURE
ZOHO_SIGN_TESTING=true
ZOHO_REFRESH_MARGIN_SECONDS=300
ZOHO_TOKEN_EXPIRATION_DEFAULT_SECONDS=3600
ZOHO_HTTP_MAX_ATTEMPTS=3
ZOHO_HTTP_INITIAL_RETRY_WAIT_SECONDS=1.0
ZOHO_HTTP_BACKOFF_FACTOR=2
ZOHO_TOKEN_TIMEOUT_SECONDS=15
ZOHO_STATUS_TIMEOUT_SECONDS=15
ZOHO_CANCEL_TIMEOUT_SECONDS=15
ZOHO_CREATE_REQUEST_TIMEOUT_SECONDS=30
ZOHO_SUBMIT_REQUEST_TIMEOUT_SECONDS=30
ZOHO_DOWNLOAD_TIMEOUT_SECONDS=60
ZOHO_SIGN_REQUEST_EXPIRATION_DAYS=15

# ── SMTP / SES ───────────────────────────────────────────────────────────────
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=REPLACE_STAGING_SMTP_USER
SMTP_PASSWORD=REPLACE_STAGING_SMTP_PASSWORD
SMTP_FROM=legal@blend360.com
SES_EMAIL_ORIGEN=legal@blend360.com
SES_NOTIFICACIONES_ENABLED=true
ALERTAS_EMAIL_DESTINATARIO=Bryan.Ariza@blend360.com
SNS_NOTIFICACIONES_ENABLED=true

# ── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_URL=https://login-staging-sagrilaft.ia.blend360.com
KEYCLOAK_REALM=sagrilaft
KEYCLOAK_CLIENT_ID=sagrilaft-portal
KEYCLOAK_ISSUER_URL=https://login-staging-sagrilaft.ia.blend360.com
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_STAGING_KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_HOSTNAME=login-staging-sagrilaft.ia.blend360.com
KEYCLOAK_DB_USER=REPLACE_STAGING_KEYCLOAK_DB_USER
KEYCLOAK_DB_PASSWORD=REPLACE_STAGING_KEYCLOAK_DB_PASSWORD
# PORTAL_AUTH_DISABLED=true fuera de development/local/test hace que el
# backend aborte al arrancar (guardrail en api/middleware/autenticacion.py).
PORTAL_AUTH_DISABLED=false

# ── Listas de cautela (verificación PLAFT) ──────────────────────────────────
# "dummy" está permitido en staging mientras la API real no esté disponible.
# En producción se debe usar "sagrilaft" con URL/API key reales.
PROVEEDOR_LISTAS_CAUTELA=dummy
SAGRILAFT_API_URL=
SAGRILAFT_API_KEY=

# ── Seguridad / runtime ──────────────────────────────────────────────────────
SECRET_KEY=REPLACE_STAGING_SECRET_KEY
MAX_UPLOAD_SIZE_MB=15
UVICORN_WORKERS=2
TRUSTED_PROXY_IPS=REPLACE_STAGING_TRUSTED_PROXY_IPS

# ── Build del frontend (Vite) ────────────────────────────────────────────────
VITE_BACKEND_URL=https://staging-sagrilaft.ia.blend360.com
VITE_PORTAL_INTERNO_URL=https://staging-sagrilaft.ia.blend360.com
VITE_KEYCLOAK_URL=https://login-staging-sagrilaft.ia.blend360.com
VITE_KEYCLOAK_REALM=sagrilaft
VITE_KEYCLOAK_CLIENT_ID=sagrilaft-portal
VITE_RAZON_SOCIAL=HIGH TECH SOFTWARE S.A.S
VITE_CORREO_DATOS=administrativocol@blend360.com
