# ── Plantilla de entorno: STAGING ───────────────────────────────────────────
# Usada por scripts/despliegue/build_and_push_ecr_images.py (--env-file, VITE_* + AWS_REGION)
# y scripts/aws/sync_aws_runtime_assets.py (--env-file, escribe solo secretos externos a CDK en Secrets Manager; dry-run por defecto).
# Copia a `.env.staging`, reemplaza cada "REPLACE_STAGING_*" con el valor real
# y NUNCA commitees ese archivo (ya está en .gitignore).
# Validado por `scripts/validacion/validate_envs.py`.

# ── Entorno ──────────────────────────────────────────────────────────────────
APP_ENV=staging

# ── Frontend / CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=https://forms-staging-sagrilaft.ia.blend360.com
PORTAL_INTERNO_URL=https://staging-sagrilaft.ia.blend360.com

# ── Almacenamiento ───────────────────────────────────────────────────────────
STORAGE_BACKEND=s3

# ── AWS / Bedrock ────────────────────────────────────────────────────────────
# No incluyas AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY aquí: en ECS se usa el
# Task Role (IAM), nunca credenciales estáticas (scripts/validacion/validate_envs.py lo
# marca como PROHIBIDO en staging/prod).
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=REPLACE_STAGING_BEDROCK_MODEL_ID
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.0
BEDROCK_CONNECT_TIMEOUT_SECONDS=10
BEDROCK_READ_TIMEOUT_SECONDS=90
BEDROCK_MAX_ATTEMPTS=3
BEDROCK_PDF_MAX_PAGES=7
BEDROCK_DEFAULT_CONFIDENCE=0.90
BEDROCK_RESPONSE_LOG_CHARS=800

# ── Zoho Sign (sandbox en staging) ──────────────────────────────────────────
ZOHO_CLIENT_ID=REPLACE_STAGING_ZOHO_CLIENT_ID
ZOHO_CLIENT_SECRET=REPLACE_STAGING_ZOHO_CLIENT_SECRET
ZOHO_REFRESH_TOKEN=REPLACE_STAGING_ZOHO_REFRESH_TOKEN
ZOHO_REDIRECT_URI=https://staging-sagrilaft.ia.blend360.com/oauth/zoho/callback
ZOHO_WEBHOOK_SECRET=REPLACE_STAGING_ZOHO_WEBHOOK_SECRET
ZOHO_WEBHOOK_SIGNATURE_HEADER=X-ZS-WEBHOOK-SIGNATURE
ZOHO_SIGN_TESTING=true
ZOHO_REFRESH_MARGIN_SECONDS=300
ZOHO_TOKEN_EXPIRATION_DEFAULT_SECONDS=3600
ZOHO_HTTP_MAX_ATTEMPTS=3
ZOHO_HTTP_INITIAL_RETRY_WAIT_SECONDS=1.0
ZOHO_HTTP_BACKOFF_FACTOR=2
ZOHO_TOKEN_TIMEOUT_SECONDS=15
ZOHO_STATUS_TIMEOUT_SECONDS=15
ZOHO_CANCEL_TIMEOUT_SECONDS=15
ZOHO_CREATE_REQUEST_TIMEOUT_SECONDS=30
ZOHO_SUBMIT_REQUEST_TIMEOUT_SECONDS=30
ZOHO_DOWNLOAD_TIMEOUT_SECONDS=60
ZOHO_SIGN_REQUEST_EXPIRATION_DAYS=15

# ── SMTP / SES ───────────────────────────────────────────────────────────────
# SMTP_USER y SMTP_PASSWORD no se declaran aquí: ECS los inyecta desde el secreto
# `sagrilaft/staging/smtp_credentials` en Secrets Manager (cargado en consola AWS).
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_FROM=no-reply-sagrilaft@ia.blend360.com
SMTP_REPLY_TO=legal@blend360.com
SES_EMAIL_ORIGEN=no-reply-sagrilaft@ia.blend360.com
SES_NOTIFICACIONES_ENABLED=true
ALERTAS_EMAIL_DESTINATARIO=equipo-alertas@example.com
# El CDK siempre despliega 'false' (config-parameters.ts) — SES es el canal
# activo de alertas, SNS no está cableado en el frontend todavía.
SNS_NOTIFICACIONES_ENABLED=false

# ── Keycloak ─────────────────────────────────────────────────────────────────
# KEYCLOAK_URL es la red INTERNA (service discovery dentro del VPC) que usa el
# backend para llamadas administrativas/JWKS — NO la URL pública. El CDK la
# fija a http://keycloak.sagrilaft-{env}.local:8080 (config-parameters.ts:46).
# KEYCLOAK_ISSUER_URL (abajo) sí es la URL pública, usada para validar el "iss"
# del JWT.
KEYCLOAK_URL=http://keycloak.sagrilaft-staging.local:8080
KEYCLOAK_REALM=sagrilaft
KEYCLOAK_CLIENT_ID=sagrilaft-portal
KEYCLOAK_ISSUER_URL=https://login-staging-sagrilaft.ia.blend360.com
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_STAGING_KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_HOSTNAME=login-staging-sagrilaft.ia.blend360.com
KEYCLOAK_DB_USER=REPLACE_STAGING_KEYCLOAK_DB_USER
KEYCLOAK_DB_PASSWORD=REPLACE_STAGING_KEYCLOAK_DB_PASSWORD
# PORTAL_AUTH_DISABLED=true fuera de development/local/test hace que el
# backend aborte al arrancar (guardrail en api/middleware/autenticacion.py).
PORTAL_AUTH_DISABLED=false

# ── Listas de cautela (verificación PLAFT) ──────────────────────────────────
# Referencia: en ECS los valores vienen de SSM y Secrets Manager (CDK). Desde 2026-11-25 los
# scripts de staging usan Tusdatos contra su sandbox (-c proveedorListasCautela=externo
# -c tusdatosUrl=http://docs.tusdatos.co); el secreto sagrilaft/staging/tusdatos_credentials
# lleva el usuario y la clave de pruebas publicados por Tusdatos. Estos valores son los del simulador local.
PROVEEDOR_LISTAS_CAUTELA=dummy
LISTAS_IMPLEMENTACION=simulado
LISTAS_SIMULACION_ESCENARIO=sin_coincidencias_v1
LISTAS_CUSTODIA_BACKEND=s3
LISTAS_TUSDATOS_URL=https://dash-board.tusdatos.co
LISTAS_TUSDATOS_TOKEN=
LISTAS_TUSDATOS_USUARIO=
LISTAS_TUSDATOS_CLAVE=
# Opcionales de Tusdatos (valores por defecto): LISTAS_TUSDATOS_ALERTA_CREDITOS=100,
# LISTAS_TUSDATOS_TIEMPO_CONEXION=5, LISTAS_TUSDATOS_TIEMPO_LECTURA=20, LISTAS_TUSDATOS_TIEMPO_PDF=60,
# LISTAS_TUSDATOS_CAPTURAS=true (capturas de pantalla por fuente como evidencia),
# LISTAS_TUSDATOS_RECUPERAR=true (recarga gratis lo que quedó incompleto después del cierre).
# Circuito anterior (retirado): ya no se usan para arrancar.
SAGRILAFT_API_URL=
SAGRILAFT_API_KEY=

# ── Seguridad / runtime ──────────────────────────────────────────────────────
SECRET_KEY=REPLACE_STAGING_SECRET_KEY
MAX_UPLOAD_SIZE_MB=15
UVICORN_WORKERS=2
TRUSTED_PROXY_IPS=REPLACE_STAGING_TRUSTED_PROXY_IPS

# ── Build del frontend (Vite) ────────────────────────────────────────────────
# No se declara VITE_BACKEND_URL: en staging/prod el frontend solo llama a
# /api relativo (same-origin) y el ALB enruta /api/* directo al backend (ver
# infra/sagrilaft/lib/constructs/load-balancer.ts). Esta variable solo existe
# en entornos de desarrollo, para el proxy del dev server de Vite.
VITE_PORTAL_INTERNO_URL=https://staging-sagrilaft.ia.blend360.com
VITE_KEYCLOAK_URL=https://login-staging-sagrilaft.ia.blend360.com
VITE_KEYCLOAK_REALM=sagrilaft
VITE_KEYCLOAK_CLIENT_ID=sagrilaft-portal
VITE_RAZON_SOCIAL=HIGH TECH SOFTWARE S.A.S
VITE_CORREO_DATOS=administrativocol@blend360.com
