<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:sagrilaft:pruebas:listas:v1" xmlns:p="urn:sagrilaft:pruebas:listas:v1" elementFormDefault="qualified">
  <xs:element name="lista">
    <xs:complexType><xs:sequence>
      <xs:element name="registro" minOccurs="1" maxOccurs="unbounded">
        <xs:complexType><xs:sequence>
          <xs:element name="nombre" type="xs:string"/>
          <xs:element name="alias" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="identificador" minOccurs="0" maxOccurs="unbounded">
            <xs:complexType><xs:simpleContent><xs:extension base="xs:string"><xs:attribute name="tipo" type="xs:string" use="required"/><xs:attribute name="pais" type="xs:string"/></xs:extension></xs:simpleContent></xs:complexType>
          </xs:element>
          <xs:element name="direccion" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="observacion" type="xs:string" minOccurs="0"/>
          <xs:element name="relacion" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:attribute name="destino" type="xs:IDREF" use="required"/></xs:complexType></xs:element>
        </xs:sequence><xs:attribute name="uid" type="xs:ID" use="required"/><xs:attribute name="clase" use="required"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="PERSONA"/><xs:enumeration value="ENTIDAD"/></xs:restriction></xs:simpleType></xs:attribute></xs:complexType>
      </xs:element>
    </xs:sequence><xs:attribute name="sintetica" type="xs:boolean" fixed="true" use="required"/></xs:complexType>
  </xs:element>
</xs:schema>
