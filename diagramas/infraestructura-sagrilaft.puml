@startuml
' Infraestructura de SAGRILAFT en AWS. Revisado contra infra/sagrilaft/lib el 2026-11-24.
!define AWSPuml https://raw.githubusercontent.com/awslabs/aws-icons-for-plantuml/v18.0/dist
!include AWSPuml/AWSCommon.puml
!include AWSPuml/AWSSimplified.puml
!include AWSPuml/General/Internet.puml
!include AWSPuml/NetworkingContentDelivery/ElasticLoadBalancing.puml
!include AWSPuml/SecurityIdentityCompliance/WAF.puml
!include AWSPuml/Containers/ElasticContainerService.puml
!include AWSPuml/Containers/Fargate.puml
!include AWSPuml/Database/RDS.puml
!include AWSPuml/Storage/SimpleStorageService.puml
!include AWSPuml/SecurityIdentityCompliance/SecretsManager.puml
!include AWSPuml/MachineLearning/Bedrock.puml
!include AWSPuml/BusinessApplications/SimpleEmailService.puml
!include AWSPuml/SecurityIdentityCompliance/CertificateManager.puml
!include AWSPuml/ManagementGovernance/CloudWatch.puml
!include AWSPuml/ApplicationIntegration/SimpleNotificationService.puml
!include AWSPuml/Containers/ElasticContainerRegistry.puml

left to right direction

actor "Contrapartes y\nequipo interno" as users

package "AWS (us-east-1), un stack por ambiente" {

  WAF(waf, "AWS WAF\nreglas administradas,\nlímite por IP y regla\npara la consola de Keycloak", " ")

  package "VPC 10.0.0.0/16 (2 zonas)" {

    package "Subredes públicas" #d5e8d4 {
      ElasticLoadBalancing(alb, "ALB\n:80 redirige a HTTPS\n:443 enruta por dominio", " ")
      component "NAT Gateway\n(salida a internet\ny a las APIs de AWS)" as nat

      note right of alb
        forms[-staging]-sagrilaft.* → Formulario (y /api → Backend)
        [staging-]sagrilaft.*        → Portal interno
        login[-staging]-sagrilaft.*  → Keycloak
      end note
    }

    package "Subredes privadas" #f8cecc {
      Fargate(fargate, "ECS Fargate\n1 copia por servicio; backend de 1 a 2", " ") {
          ElasticContainerService(ecs_back, "Backend (FastAPI)", " ")
          ElasticContainerService(ecs_form, "Formulario público", " ")
          ElasticContainerService(ecs_portal, "Portal interno", " ")
          ElasticContainerService(ecs_auth, "Keycloak", " ")
          ElasticContainerService(ecs_worker, "Trabajador de listas\n(0 copias si las listas\nestán deshabilitadas)", " ")
      }

      RDS(rds, "RDS PostgreSQL 16\nuna zona, cifrada", " ")
    }

    component "Endpoint gateway de S3\n(gratuito, no pasa por el NAT)" as s3gw
  }

  CertificateManager(acm, "Certificado ACM\n*.ia.blend360.com (compartido)", " ")
  SimpleStorageService(s3, "S3\ndocumentos, PDF, informes de listas\ny registros del ALB", " ")
  SecretsManager(sm, "Secrets Manager y SSM\nsecretos y configuración", " ")
  Bedrock(bedrock, "Amazon Bedrock\nmodelo configurado por ambiente", " ")
  SimpleEmailService(ses, "Amazon SES\ncorreos a contrapartes\ny avisos internos", " ")
  CloudWatch(cw, "CloudWatch\nregistros, 16 alarmas\ny dos tableros", " ")
  SimpleNotificationService(sns, "SNS\navisos de alarmas\n(solo producción)", " ")
  ElasticContainerRegistry(ecr, "ECR\nimágenes por SHA, inmutables", " ")
}

cloud "Terceros" {
    component "Zoho Sign\n(firma electrónica)" as zoho
    component "Tusdatos\n(listas; sin credenciales,\ndeshabilitado en producción)" as tusdatos
}

users --> waf : HTTPS
waf --> alb
acm -[#red,dashed]-> alb : TLS

alb --> ecs_form : :8080
alb --> ecs_portal : :8080
alb --> ecs_auth : :8080
alb --> ecs_back : :8000 (/api)

ecs_back -[#red]-> rds : :5432
ecs_auth -[#red]-> rds : :5432 (misma base)
ecs_worker -[#red]-> rds : :5432

ecs_back -[#teal,dashed]-> s3gw
ecs_worker -[#teal,dashed]-> s3gw
s3gw -[#teal,dashed]-> s3
alb -[#teal,dashed]-> s3 : registros de acceso (90 días)

fargate -[#gray,dashed]-> nat : salida
nat -[#gray,dashed]-> ecr : imágenes
nat -[#purple,dashed]-> sm
nat -[#purple,dashed]-> bedrock : PDF recortado a 7 páginas
nat -[#orange,dashed]-> ses : SMTP / API
nat -[#blue,dashed]-> cw : registros
nat -[#green,dashed]-> zoho : API saliente
nat -[#gray,dashed]-> tusdatos : API saliente
zoho -[#green,dashed]-> alb : POST /api/webhooks/zoho-sign\n(firma HMAC)
cw -[#pink,dashed]-> sns : alarmas
ecs_back -[#black,dashed]-> ecs_auth : Cloud Map\nkeycloak.sagrilaft-<ambiente>.local

@enduml
