{
  "name": "sagrilaft-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "shared"
  ],
  "scripts": {
    "dev": "npm --prefix apps/formulario-publico run dev",
    "build": "npm --prefix apps/formulario-publico run build",
    "preview": "npm --prefix apps/formulario-publico run preview",
    "dev:publico": "npm --prefix apps/formulario-publico run dev",
    "build:publico": "npm --prefix apps/formulario-publico run build",
    "preview:publico": "npm --prefix apps/formulario-publico run preview",
    "dev:portal": "npm --prefix apps/portal-interno run dev",
    "build:portal": "npm --prefix apps/portal-interno run build",
    "preview:portal": "npm --prefix apps/portal-interno run preview"
  },
  "dependencies": {
    "lucide-react": "^1.24.0"
  }
}
